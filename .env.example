# Copy this file to .env and fill in real values. aat_main.py and
# optimize_gepa.py both load .env the same way -- see USAGE.md.

API_BASE=https://suarezai.holycross.edu/litellm
MODEL=litellm_proxy/anthropic/Claude Opus 5
API_KEY=your-key-here

# For a local, unauthenticated model (e.g. Ollama), leave API_KEY present
# but empty:
# API_BASE=http://localhost:11434
# MODEL=ollama_chat/llama3
# API_KEY=

# Optional: a separate (typically stronger reasoning) model for GEPA's own
# reflective step (optimize_gepa.py). Falls back to the task model above
# if unset.
# REFLECTION_MODEL=litellm_proxy/anthropic/Claude Opus 5
# REFLECTION_API_BASE=
# REFLECTION_API_KEY=
